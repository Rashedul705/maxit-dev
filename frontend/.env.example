# Backend API Connection (Internal SSR and Rewrites proxy)
# In Coolify, set this to the internal service URL (e.g. http://backend:5001).
# NOTE: Next.js evaluates rewrites at build time, so this variable must be available during build.
BACKEND_INTERNAL_URL=http://localhost:5001

# Fallback Data Toggle (default false in production, true in development)
# When false: Backend failure/timeout throws an error and will NOT silently render empty fallback data.
# When true: Backend failure logs a server-side error and renders fallback data.
FALLBACK_DATA_ENABLED=false

# Authentication (Must match backend JWT_SECRET for middleware token verification)
JWT_SECRET=replace_with_same_jwt_secret_used_in_backend
