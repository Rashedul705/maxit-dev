# Server Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
TRUST_PROXY_HOPS=2
UPLOAD_DIR=./uploads

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database_name?appName=Maxit

# Authentication & Security
JWT_SECRET=replace_with_strong_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_secure_initial_admin_password
CRON_SECRET=replace_with_random_hex_secret_for_cron_sync

# Image Hosting (ImgBB)
IMGBB_API_KEY=replace_with_imgbb_api_key

# Outgoing Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=replace_with_gmail_app_password_16_chars
MAIL_FROM="Max iT Solution <your_email@gmail.com>"
SITE_URL=https://yourdomain.com

# Incoming Email Sync (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SYNC_INTERVAL_SECONDS=15
IMAP_SYNC_ENABLED=true
